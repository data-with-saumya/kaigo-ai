# Copy to frontend/.env.local. Firebase web config values are public identifiers, not secrets,
# but keep them out of git anyway. Leave them empty to run locally without Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Empty = same origin (/api is proxied in dev and rewritten to Cloud Run by Firebase Hosting).
VITE_API_BASE_URL=

# Copy to backend/.env for local development. Never commit the real .env.
APP_ENV=local
STORAGE_BACKEND=memory          # memory | firestore
AUTH_MODE=dev                   # dev | firebase
GEMINI_BACKEND=vertex           # off | vertex | api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LOCATION=global
GOOGLE_CLOUD_PROJECT=your-project-id
# GEMINI_API_KEY=               # only if GEMINI_BACKEND=api_key (local experiments)
CORS_ORIGINS=http://localhost:5173
TRAVEL_BACKEND=google_maps         # straight_line | google_maps (Routes API, uses the service identity)
